# Parameter kebijakan. Semua nilai di bawah ILUSTRATIF: ganti dengan data resmi
# (mis. garis kemiskinan BPS daerah) sebelum dipakai untuk keputusan nyata.
# Berkas ini di-commit sebagai templat; salin menjadi .env untuk pemakaian lokal.

# Rupiah per bulan. Pendapatan di bawah angka ini, bersama penyakit kronis,
# memicu kewajiban mutlak Kant.
BATAS_KEMISKINAN=600000

# Rupiah per anggota rumah tangga. Dalam Rupiah agar satu satuan dengan pendapatan.
KEBUTUHAN_DASAR_PER_TANGGUNGAN=800000

# Pengali kebutuhan bila ada penyakit kronis. Minimal 1.0.
PENGALI_KESEHATAN_KRONIS=1.5

# Selisih kebutuhan dan pendapatan (Rupiah) yang dipetakan ke ujung skala 0 atau 100.
SKALA_UTILITAS=5000000

# Harus berjumlah 1.0. BOBOT_ML x 100 wajib lebih kecil dari AMBANG_KUOTA,
# jika tidak aplikasi menolak start.
BOBOT_UTILITAS=0.6
BOBOT_ML=0.4

# Skor gabungan minimum (0-100) untuk lolos kuota.
AMBANG_KUOTA=50

# Rupiah per penerima; dipakai /analisis-batch bila request tidak menyebutkan besaran.
NILAI_BANTUAN_PER_PEMOHON=2000000

# CORS: asal (origin) frontend yang boleh memanggil API ini dari browser.
# Berbeda dari parameter kebijakan di atas, dua baris ini boleh dihapus; nilai
# bawaannya sama dengan di bawah (pengembangan lokal dan domain Lovable).
# Sebelum dipublikasikan, sempitkan ke alamat frontend yang sebenarnya.
# CORS_ALLOW_ORIGIN_REGEX dikosongkan bila ingin mematikan pencocokan pola.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173
CORS_ALLOW_ORIGIN_REGEX=https://([a-z0-9-]+\.)*(lovable\.app|lovableproject\.com)
